# Salvage — environment contract.
# Copy to .env and fill in. .env is gitignored and must never be committed (NFR-06).
# Every variable the code reads is named here. If you add one, add it here in the
# same commit or api/config.py will refuse to start.

# ── Razorpay (test mode only) ────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Webhook signing secret. HMAC is verified on the RAW body — see FR-01.
# You choose this value when creating the webhook in the Dashboard, not
# Razorpay. Put ONLY the secret on this line — no trailing comment. Found on
# day 1: an inline "# ..." comment after the value doesn't break the real app
# (pydantic-settings strips it), but it silently breaks any script with a
# simpler hand-rolled .env parser. Keep this line bare either way.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com

# ── MongoDB Atlas (M0) ───────────────────────────────────────────────────────
# Full SRV connection string, credentials inline.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=salvage
# Optional: used only by scripts/ that build the URI from parts.
MONGODB_USERNAME=
MONGODB_PASSWORD=

# ── LLM (diagnosis only — never chooses a money action; invariant 2) ─────────
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# Fallback used when the primary times out (NFR-01: 8s cap).
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# Separate, cheaper model for nudge-template rendering (F24). Not a decision path.
LLM_TEMPLATE_MODEL=
# Skips the LLM call entirely — the normaliser's output passes straight
# through as the diagnosis (arm C, SPEC §5.10). Never a money-path bypass:
# the normaliser already wins over the LLM whenever it isn't UNKNOWN either way.
DISABLE_LLM=false

# ── Safety controls ──────────────────────────────────────────────────────────
# DRY_RUN defaults true. Going live requires api.executor.arm.arm(token) to be
# called with the token below and match — there is no HTTP route for this yet
# (POST /control/arm is PRD §7, not built this phase; arm() is a Python-level
# call today, exercised directly in tests — see README.md). There is no flag
# that skips the gate chain (invariants 4 and 8).
DRY_RUN=true
ARM_CONFIRM_TOKEN=change-me-before-arming
KILL_SWITCH=false
# The live scheduler tick, in seconds. 0 means no background loop starts at
# all — which is the default, for the same reason DRY_RUN defaults true: a
# process that dispatches money actions on a timer should be something you
# turned on, not something that happened because you ran the server. Set it
# (5 is a sensible demo value) and a replanned action actually fires, with all
# eleven gates re-evaluated against the world as it is at fire time rather
# than as it looked when the action was scheduled. api/scheduler/live.py.
SCHEDULER_TICK_SECONDS=0
# Reserved for a future HMAC upgrade of the hash chain. PRD §8.4 specifies a
# plain sha256 chain, so nothing reads this today. Named here so it is not
# silently introduced later.
AUDIT_CHAIN_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=dev
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
# Storage zone. Always UTC — do not change (NFR-04).
TZ=UTC
# Zone all gate logic is evaluated in, and the zone rendered in every UI
# timestamp. Always IST.
COMPLIANCE_TZ=Asia/Kolkata

# ── Local webhook tunnel (Razorpay requires port 80/443) ─────────────────────
PUBLIC_WEBHOOK_URL=
NGROK_AUTHTOKEN=

# ── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://127.0.0.1:8000
